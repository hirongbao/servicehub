# SMTP 配置：复制为 .env 后填写真实的邮箱授权码，不要提交 .env
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=replace-with-email-authorization-code

