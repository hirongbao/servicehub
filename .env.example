# 复制为 .env 后填写；不要提交 .env
MYSQL_ROOT_PASSWORD=replace-with-your-mysql-root-password

# Spring Boot 数据库连接
DB_URL=jdbc:mysql://localhost:3306/servicehub?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=replace-with-your-mysql-root-password

# 管理员账号
SERVICEHUB_ADMIN_USERNAME=hirongbao
SERVICEHUB_ADMIN_PASSWORD=replace-with-a-new-admin-password

# 腾讯 COS（上海地域代码为 ap-shanghai）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
# 通常填写完整 Bucket 名称，例如 hirongbao-1250000000
COS_BUCKET=hirongbao
COS_PUBLIC_URL_ENABLED=true
